<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.netscope.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/netscope-agent</string>
        <string>--config</string>
        <string>/Library/Application Support/Netscope/agent.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/netscope-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/netscope-agent.err</string>
</dict>
</plist>
