# Netscope Environment Configuration
# Copy this file to .env and adjust values for your setup.

## TUI
# NETSCOPE_THEME=dark        # UI theme (dark/light)

## Security
# NETSCOPE_PASSPHRASE=       # Encryption passphrase for sensitive data
# NETSCOPE_AGENT_UPDATE_PUBKEY=  # Public key for agent update verification

## TLS/SSL Decryption
# TLS_RSA_PRIVATE_KEY=       # Path to RSA private key for TLS decryption
# SSLKEYLOGFILE=             # Path to NSS SSL key log file

## IPsec Decryption
# IPSEC_ESP_KEYS=            # IPsec ESP decryption keys

## Kerberos Decryption
# KRB_KEY=                   # Kerberos key for decryption

## WLAN Decryption
# WLAN_WEP_KEY=              # WEP key for wireless decryption
# WLAN_WPA_PASSPHRASE=       # WPA passphrase
# WLAN_SSID=                 # WLAN SSID
# WLAN_WPA_TK=               # WPA temporal key

## Application
# NETSCOPE_CONFIG_DIR=       # Override config directory path
# NETSCOPE_PROFILE=          # Active configuration profile
